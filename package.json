{
  "name": "pocketworld",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "An agent skill: one sentence, one image, a living pixel world for videos and websites.",
  "bin": {
    "pocketworld": "cli/pocketworld.js"
  },
  "scripts": {
    "start": "node cli/pocketworld.js dev",
    "dev": "node cli/pocketworld.js dev",
    "demo": "node cli/pocketworld.js dev",
    "doctor": "node cli/pocketworld.js doctor",
    "setup": "node cli/pocketworld.js setup",
    "render": "node cli/pocketworld.js render",
    "test": "node --test tests/*.test.js",
    "test:native": "node tests/native-delivery.mjs",
    "test:install": "node tests/install-smoke.mjs",
    "package:release": "node tools/package.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "24.15.0",
    "playwright": "1.62.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
